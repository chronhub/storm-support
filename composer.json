{
    "name": "chronhub/storm-support",
    "description": "Storm Support — the shared concrete substrate: small, stateless mechanisms several packages need and that cannot live in Contracts.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "support"],
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.0",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Support\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Support\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
